<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for Firebase Authentication, Firestore, and Network checks -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Fitness App"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fitness_app"
        tools:targetApi="31">

        <!-- Login Screen (Launcher Activity: App starts here) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registration Screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Main Dashboard Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- BMI Calculator Screen (Matches BMICalculatorActivity.java) -->
        <activity
            android:name=".BMICalculatorActivity"
            android:exported="false" />

        <!-- Calorie Calculator Screen -->
        <activity
            android:name=".CalorieCalculatorActivity"
            android:exported="false" />

        <!-- Exercise Detail Screen -->
        <activity
            android:name=".ExerciseDetailActivity"
            android:exported="false" />

    </application>

</manifest>