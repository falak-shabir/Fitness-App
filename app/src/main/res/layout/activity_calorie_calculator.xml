<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:text="Daily Calorie Calculator"
            android:textColor="#212529"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Calculate maintenance, bulking, and cutting calories based on your activity."
            android:textColor="#6C757D"
            android:textSize="13sp" />

        <!-- Gender Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Gender"
            android:textColor="#495057"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:checked="true"
                android:text="Male" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female" />
        </RadioGroup>

        <!-- Stats Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCalAge"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Age (yrs)"
                android:inputType="number"
                android:paddingHorizontal="10dp" />

            <EditText
                android:id="@+id/etCalWeight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Weight (kg)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp" />

            <EditText
                android:id="@+id/etCalHeight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Height (cm)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <!-- Activity Level Dropdown / Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Activity Level"
            android:textColor="#495057"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerActivityLevel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/btn_dropdown" />

        <Button
            android:id="@+id/btnCalculateCalories"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#28A745"
            android:text="Calculate Targets"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Calorie Results Card -->
        <LinearLayout
            android:id="@+id/layoutCalorieResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBmrValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="BMR: -- kcal/day"
                android:textColor="#6C757D"
                android:textSize="13sp" />

            <!-- Maintenance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maintenance Calories (TDEE)"
                android:textColor="#495057"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvMaintenanceCals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="2,200 kcal/day"
                android:textColor="#007BFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Weight Loss -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight Loss (500 kcal deficit)"
                android:textColor="#495057"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvWeightLossCals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="1,700 kcal/day"
                android:textColor="#DC3545"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Muscle Gain -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muscle Gain (300 kcal surplus)"
                android:textColor="#495057"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvWeightGainCals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2,500 kcal/day"
                android:textColor="#28A745"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>