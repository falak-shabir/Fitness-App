<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="BMI Calculator"
            android:textColor="#212529"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Calculate your Body Mass Index and health category."
            android:textColor="#6C757D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Weight (kg)"
            android:textColor="#495057"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBmiWeight"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="e.g. 70.5"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Height (cm)"
            android:textColor="#495057"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBmiHeight"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="e.g. 175"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnCalculateBmi"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#007BFF"
            android:text="Calculate BMI"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Result Card -->
        <LinearLayout
            android:id="@+id/layoutBmiResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your BMI Score"
                android:textColor="#6C757D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvBmiScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="22.5"
                android:textColor="#007BFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBmiCategoryResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Category: Normal Weight"
                android:textColor="#28A745"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBmiDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="You have a healthy body weight. Maintain your workout and balanced diet."
                android:textColor="#495057"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveBmiToProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#28A745"
                android:text="Save Weight To Profile"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>