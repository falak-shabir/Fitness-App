<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="Workout Tracker"
        android:textColor="#212529"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Workout Entry Form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etExerciseName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Exercise Name (e.g., Bench Press)"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etSets"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Sets"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etReps"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Reps"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etWorkoutWeight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Kg"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddWorkout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#007BFF"
            android:text="Log Workout"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/workoutProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyWorkout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:text="No workouts logged yet today."
        android:textColor="#6C757D"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkouts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>